# -----------------------------------------------------------------------------
# Copy this file to .env and fill in real values before running:
#   docker compose up
#
# Never commit the actual .env file — only this .env.example template.
# -----------------------------------------------------------------------------

# Which built image to pull from GHCR. Matches the floating tags produced
# by .github/workflows/docker-build-push.yml:
#   latest-prod  -> built from the main branch
#   latest-test  -> built from any other branch (develop, feature/*, etc.)
# You can also pin to an immutable short-SHA tag from a specific workflow
# run instead, e.g. IMAGE_TAG=1a2b3c4d5e6f
IMAGE_TAG=latest-test

# --- PostgreSQL connection ---
# Point this at an existing Postgres instance. This image does not run
# its own database.
#
# NOTE if using Supabase: the pooled connection role (pooler.supabase.com)
# does not have CREATEDB rights, and its transaction/lock-timeout
# handling can interrupt Odoo's initial schema bootstrap. If you hit
# "Access Denied" on database creation or "canceling statement due to
# lock timeout" during first init, see the project README for the
# manual pg_dump/pg_restore migration steps used to work around this,
# or use a non-pooled/direct connection string if your plan offers one.
DB_HOST=your-postgres-host.example.com
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=change-me

# Name of an EXISTING database to use. Odoo will initialize/use this
# database in place rather than creating a new one — required because
# many managed/pooled Postgres roles lack CREATEDB privileges.
DB_NAME=meter_invoice

# --- Odoo ---
# Master password used for Odoo's database management screens
# (create/backup/restore/drop databases). Keep this secret and strong —
# anyone with it can manage every database on this Odoo instance.
ADMIN_PASSWORD=change-me-too

# --- First-boot module installation ---
# Set to "true" for exactly ONE deploy/run to install modules into
# DB_NAME (needed the first time this connects to a database with no
# Odoo schema yet). Set back to "false" for all subsequent runs —
# leaving it "true" re-runs module install/upgrade logic on every boot.
AUTO_INIT=false

# Comma-separated modules to install when AUTO_INIT=true.
INIT_MODULES=base,meter_invoice
